# Copy to .env.development and set your dev/QA backend values before building.
# Used by: npm run build:android:release-dev
#
# HTTP and private/LAN URLs are ALLOWED (dev backends often lack TLS/public DNS).
# If EXPO_PUBLIC_API_URL points to a private host, the script prints a warning
# but does not fail — verify the test devices can reach that host.

EXPO_PUBLIC_API_URL=https://api.dev.your-host.com/api/v1

# Google Maps SDK for Android API key.
# Required by react-native-maps on Android; without it the app crashes when opening a route/map.
# You can reuse the production key as long as it's restricted to package `com.logistica.mobile`.
GOOGLE_MAPS_ANDROID_API_KEY=

# Reverb (WebSocket) — realtime updates. Sin estos vars, la app cae a polling
# cada 15 s y muestra "Sin conexión realtime". Ver REVERB.md en el root.
# EXPO_PUBLIC_REVERB_APP_KEY debe ser IGUAL al REVERB_APP_KEY del backend dev.
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=ws.dev.your-host.com
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_SCHEME=https
