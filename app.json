{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.12.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use the camera to scan QR codes.",
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to show your position on the delivery map and detect when you are near the destination.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to attach a delivery photo."
      }
    },
    "android": {
      "package": "com.logistica.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir $(PRODUCT_NAME) Acceder a la cámara para escanear códigos QR."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir $(PRODUCT_NAME) Usar su ubicación en el mapa y alertas de proximidad al destino.",
          "locationAlwaysAndWhenInUsePermission": "Permitir $(PRODUCT_NAME) Compartir su ubicación con el despacho mientras entrega, incluso cuando la aplicación está en segundo plano.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir $(PRODUCT_NAME) Elegir una foto de entrega."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#0D347D"
        }
      ],
      "./plugins/withFlexAppQuery",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7F8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#101923"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "a77d5987-3dbe-44e0-bf51-eb718510de4d"
      }
    }
  }
}
