# Copy to .env.production and set your production values before building.
# Used by: npm run build:android:production
#
# EXPO_PUBLIC_API_URL must be HTTPS and reachable from client devices (not localhost or LAN IPs).

EXPO_PUBLIC_API_URL=https://api.your-production-host.com/api/v1

# Google Maps SDK for Android API key.
# Required by react-native-maps on Android; without it the app crashes when opening a route/map.
# Restrict this key in Google Cloud Console to package `com.logistica.mobile` and the Maps SDK for Android.
GOOGLE_MAPS_ANDROID_API_KEY=
