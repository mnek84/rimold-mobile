# Copy to .env.production and set your production values before building.
# Used by: npm run build:android:production
#
# EXPO_PUBLIC_API_URL must be HTTPS and reachable from client devices (not localhost or LAN IPs).

EXPO_PUBLIC_API_URL=https://api.your-production-host.com/api/v1

# Google Maps SDK for Android API key.
# Required by react-native-maps on Android; without it the app crashes when opening a route/map.
# Restrict this key in Google Cloud Console to package `com.logistica.mobile` and the Maps SDK for Android.
GOOGLE_MAPS_ANDROID_API_KEY=

# Reverb (WebSocket) — realtime updates. Sin estos vars, la app cae a polling
# cada 15 s y muestra "Sin conexión realtime". Ver REVERB.md en el root.
# EXPO_PUBLIC_REVERB_APP_KEY debe ser IGUAL al REVERB_APP_KEY del backend
# (nunca subas el APP_SECRET al cliente).
# En producción se termina TLS con un proxy reverso (nginx/caddy) en el
# subdominio ws.*, por eso el port es 443 y el scheme https/wss.
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=ws.your-production-host.com
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_SCHEME=https
